# .env.example — Copy to .env for local dev, set as Railway env vars for production

# ── Required in production ────────────────────────────────────────────────────
# Generate a strong secret key: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=navratri-dev-secret-key-change-in-production

# Set False in production
DEBUG=True

# Railway sets this automatically — you don't need to set it manually on Railway
# DATABASE_URL=postgresql://user:password@host:port/dbname

# ── Optional ──────────────────────────────────────────────────────────────────
# Comma-separated list of allowed hosts (Railway domains are allowed automatically)
ALLOWED_HOSTS=localhost,127.0.0.1
